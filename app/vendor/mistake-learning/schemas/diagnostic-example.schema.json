{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "revision_reasons": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "canonical_node_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "error_types": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "understanding": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "outcome": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "diagnostic_patterns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "example_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "group_id": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "type": [
        "string",
        "null"
      ]
    },
    "chapter": {
      "type": [
        "string",
        "null"
      ]
    },
    "student_answer": {
      "type": [
        "string",
        "null"
      ]
    },
    "optional_correct_answer": {
      "type": [
        "string",
        "null"
      ]
    },
    "student_solution": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "text"
        ],
        "additionalProperties": false
      }
    },
    "supplemental_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "text"
        ],
        "additionalProperties": false
      }
    },
    "original_diagnosis": {
      "type": "object"
    },
    "final_diagnosis": {
      "type": "object"
    },
    "canonical_knowledge_nodes": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "feedback_quality": {
      "enum": [
        "verified",
        "strong"
      ]
    },
    "split": {
      "enum": [
        "train"
      ]
    },
    "eligibility": {
      "enum": [
        "eligible"
      ]
    },
    "evidence_references": {
      "type": "object",
      "properties": {
        "mistake_id": {
          "type": "string",
          "minLength": 1
        },
        "revision_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "feedback_event_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "step_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "effective_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "mistake_id",
        "revision_ids",
        "feedback_event_ids",
        "step_ids",
        "effective_at"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "revision_reasons",
    "canonical_node_ids",
    "error_types",
    "understanding",
    "outcome",
    "diagnostic_patterns",
    "example_id",
    "version",
    "question",
    "group_id",
    "subject",
    "chapter",
    "student_answer",
    "optional_correct_answer",
    "student_solution",
    "supplemental_evidence",
    "original_diagnosis",
    "final_diagnosis",
    "canonical_knowledge_nodes",
    "feedback_quality",
    "split",
    "eligibility",
    "evidence_references"
  ],
  "additionalProperties": false
}
