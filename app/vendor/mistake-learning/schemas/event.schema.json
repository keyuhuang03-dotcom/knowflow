              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "explanation": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "target_mistake_id": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
