                                  "type": "string",
                                  "minLength": 1,
                                  "pattern": "\\S"
                                }
                              },
                              "reason": {
                                "type": "string",
                                "minLength": 1,
                                "pattern": "\\S"
                              }
                            },
                            "required": [
                              "action",
                              "candidate_ids",
                              "reason"
                            ],
                            "additionalProperties": false
                          }
                        },
                        "required": [
                          "key",
                          "path",
                          "aliases",
                          "existing_id",
                          "outcome",
                          "understanding",
                          "independent",
                          "hint_required",
                          "confidence",
                          "evidence"
                        ],
                        "additionalProperties": false
