                          "derivation": {
                            "type": "string",
                            "minLength": 1,
                            "pattern": "\\S"
                          },
                          "why_here": {
                            "type": "string",
                            "minLength": 1,
                            "pattern": "\\S"
                          }
                        },
                        "required": [
                          "expression",
                          "symbols",
                          "conditions",
                          "derivation",
                          "why_here"
                        ],
                        "additionalProperties": false
                      },
                      "minItems": 0
                    },
                    "correct_reasoning": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      },
                      "minItems": 0
                    },
                    "trigger_conditions": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      },
                      "minItems": 0
                    },
                    "transfer_questions": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      },
                      "maxItems": 2
                    },
                    "presentation": {
                      "type": "object",
                      "properties": {
                        "question": {
                          "type": "string",
                          "minLength": 1,
                          "pattern": "\\S"
                        },
                        "student_answer": {
                          "type": "string",
                          "minLength": 1,
                          "pattern": "\\S"
                        },
                        "correct_answer": {
                          "type": "string",
                          "minLength": 1,
                          "pattern": "\\S"
                        },
                        "student_solution": {
                          "type": "object",
                          "additionalProperties": {
                            "type": "string",
                            "minLength": 1,
                            "pattern": "\\S"
                          }
                        }
                      },
                      "additionalProperties": false
                    }
