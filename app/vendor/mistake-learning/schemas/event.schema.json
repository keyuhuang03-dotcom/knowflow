                            "minLength": 1,
                            "pattern": "\\S"
                          },
                          "step_id": {
                            "type": "string",
                            "minLength": 1,
                            "pattern": "\\S"
                          },
                          "knowledge_keys": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "minLength": 1,
                              "pattern": "\\S"
                            },
                            "minItems": 1
                          },
                          "evidence": {
                            "type": "string",
                            "minLength": 1,
                            "pattern": "\\S"
                          },
                          "cause": {
