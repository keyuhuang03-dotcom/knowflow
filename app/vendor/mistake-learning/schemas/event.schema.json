            "source",
            "reason",
            "explanation",
            "node_id",
            "new_name",
            "expected_catalog_hash"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "event_key": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
