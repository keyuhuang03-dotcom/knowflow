                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "minLength": 1,
                            "pattern": "\\S"
                          },
                          "text": {
                            "type": "string",
                            "minLength": 1,
                            "pattern": "\\S"
                          }
                        },
                        "required": [
                          "id",
                          "text"
                        ],
                        "additionalProperties": false
                      },
                      "minItems": 1
                    },
                    "student_answer": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1,
                          "pattern": "\\S"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "correct_answer": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1,
                          "pattern": "\\S"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "subject": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1,
                          "pattern": "\\S"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "chapter": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1,
                          "pattern": "\\S"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "source": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "source_location": {
