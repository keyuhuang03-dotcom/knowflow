                      "minItems": 0
                    },
                    "formulas": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "expression": {
                            "type": "string",
                            "minLength": 1,
                            "pattern": "\\S"
                          },
                          "symbols": {
                            "type": "object",
                            "additionalProperties": {
                              "type": "string",
                              "minLength": 1,
                              "pattern": "\\S"
                            },
                            "minProperties": 1
                          },
                          "conditions": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "minLength": 1,
                              "pattern": "\\S"
                            },
                            "minItems": 1
