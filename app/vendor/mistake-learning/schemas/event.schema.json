                "user_correction",
                "ai_reanalysis",
                "node_merge",
                "data_fix"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "explanation": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "target_mistake_id": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "target_attempt_key": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "expected_effective_hash": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "replacement": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "$id": "https://local.invalid/mistake-draft.schema.json",
              "type": "object",
              "properties": {
                "schema_version": {
                  "enum": [
                    "1.0",
                    "1.1"
