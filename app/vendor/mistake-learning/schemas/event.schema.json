                              "minLength": 1,
                              "pattern": "\\S"
                            },
                            "minItems": 4,
                            "maxItems": 4
                          },
                          "aliases": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "minLength": 1,
                              "pattern": "\\S"
