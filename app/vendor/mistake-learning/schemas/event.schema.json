    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "after_mistake_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "previous_event_hash": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        {
          "type": "null"
        }
      ]
    },
    "event_hash": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "request_hash": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
