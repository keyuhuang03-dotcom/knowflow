DATABASE_URL="file:./dev.db"
# Set an absolute server directory in production, e.g. /data/uploads.
UPLOAD_ROOT=""
DEEPSEEK_API_KEY=""

# Image analysis: vision-capable Chat Completions provider, separate from text AI
MISTAKE_AI_API_KEY=""
MISTAKE_AI_BASE_URL="https://api.openai.com/v1"
MISTAKE_AI_MODEL=""

MISTAKE_SKILL_DIR=""
MISTAKE_SKILL_DATA_ROOT=""
MISTAKE_SKILL_PYTHON="python3"

# Use the exact origin opened in your browser; HTTPS is required on public production hosts.
APP_ORIGIN=http://localhost:3000
AUTH_USERNAME=learner
AUTH_PASSWORD_HASH=
AUTH_SECRET=

# Counts AI operations (a two-stage analysis counts as one), Shanghai calendar day.
AI_DAILY_LIMIT=100
# Production remains closed unless explicitly enabled for a maintenance window.
ALLOW_WEB_RESTORE=false
BACKUP_ROOT=
BACKUP_TOOL_PATH=
