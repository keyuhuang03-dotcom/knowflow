# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/app/node_modules
/app/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/app/coverage

# next.js
/app/.next/
/app/out/

# production
/app/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/src/generated/prisma

# local database
*.db
*.db-journal
app/prisma/dev.db

# uploads
app/public/uploads/
app/data/mistake-skill/

# local editor settings
/.claude/
/.windsurf/

# SQLite auxiliary files
*.db-wal
*.db-shm

# Cloud deployment secrets and persistent data
/deploy/app.env
/deploy/Caddyfile
/data/

# temporary Office files
~$*

# Python runtime caches
__pycache__/
*.pyc

# Atomic login configuration temporary files
/deploy/app.env.*.tmp

# Generated container config and private restoration staging
/app/next.config.mjs
/data-before-restore-*/
/.restore-staging.*/


.knowflow-maintenance.lock

# Local-only graph comparison experiment; bundled system font is not distributable.
/tools/limit-graph-demo/
